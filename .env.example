APP_ENV=development
SESSION_SECRET=change-me

# Application database
APP_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/support_agent

# LangGraph checkpoint database (same database, separate schema)
LANGGRAPH_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/support_agent
LANGGRAPH_SCHEMA=langgraph

# LLM provider
LLM_PROVIDER=openai-compatible
LLM_MODEL=
LLM_BASE_URL=
OPENAI_API_KEY=

# Mock service URLs
PAYMENT_SERVICE_URL=http://localhost:8001
SHIPPING_SERVICE_URL=http://localhost:8002
TICKETING_SERVICE_URL=http://localhost:8003

# Demo accounts
DEMO_CUSTOMER_EMAIL=customer@example.com
DEMO_REVIEWER_EMAIL=reviewer@example.com
